# Panther API Configuration
FLASK_ENV=development
DEBUG=True
PORT=8080

# AWS S3 Configuration (for real implementation)
# Replace with your actual AWS credentials to use real S3 data
AWS_ACCESS_KEY=your_aws_access_key_here
AWS_SECRET_KEY=your_aws_secret_key_here
AWS_REGION=us-west-2
PG_TREE_BUCKET=phg-panther-data-19
PG_MSA_BUCKET=phg-panther-msa-data-19

# Mock Data Configuration
# Set to 'false' to use real S3 data (requires valid AWS credentials)
USE_MOCK_DATA=false
MOCK_DATA_PATH=./mock_data

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=panther_api.log

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost:8080